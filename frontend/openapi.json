  "components": {
    "schemas": {
      "Blueprint": {
        "properties": {
          "has_input": {
            "type": "boolean",
            "title": "Has Input",
            "default": false
          },
          "components": {
            "items": {
              "$ref": "#/components/schemas/ComponentSpec"
            },
            "type": "array",
            "maxItems": 16,
            "title": "Components"
          }
        },
        "type": "object",
        "title": "Blueprint"
      },
      "ComponentSpec": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "maxLength": 40,
            "title": "Kind"
          },
          "parameters": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Parameters"
          },
          "custom": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CustomComponent"
              },
              {
                "type": "null"
              }
            ]
          },
          "arguments": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Arguments"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "title": "ComponentSpec"
      },
      "ComponentStage": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "input_shape": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Input Shape"
          },
          "shape": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shape"
          },
          "axes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Axes"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "input_shape"
        ],
        "title": "ComponentStage"
      },
      "CompositionPlan": {
        "properties": {
          "validation_required": {
            "type": "boolean",
            "title": "Validation Required",
            "default": false
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "stages": {
            "items": {
              "$ref": "#/components/schemas/ComponentStage"
            },
            "type": "array",
            "title": "Stages"
          },
          "valid": {
            "type": "boolean",
            "title": "Valid"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "code",
          "stages",
          "valid"
        ],
        "title": "CompositionPlan"
      },
      "CompositionRequest": {
        "properties": {
          "blueprint": {
            "$ref": "#/components/schemas/Blueprint"
          },
          "input": {
            "$ref": "#/components/schemas/InputSpec"
          },
          "capture_mode": {
            "type": "string",
            "enum": [
              "values",
              "shapes"
            ],
            "title": "Capture Mode",
            "default": "values"
          }
        },
        "type": "object",
        "required": [
          "blueprint"
        ],
        "title": "CompositionRequest"
      },
      "CustomComponent": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "description": {
            "type": "string",
            "maxLength": 240,
            "title": "Description",
            "default": ""
          },
          "code": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Code"
          },
          "class_name": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[A-Za-z_]\\w*$",
            "title": "Class Name"
          },
          "constructor": {
            "additionalProperties": true,
            "type": "object",
            "title": "Constructor"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "name",
          "code",
          "class_name",
          "id",
          "created_at"
        ],
        "title": "CustomComponent"
      },
      "CustomComponentDraft": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "description": {
            "type": "string",
            "maxLength": 240,
            "title": "Description",
            "default": ""
          },
          "code": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Code"
          },
          "class_name": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[A-Za-z_]\\w*$",
            "title": "Class Name"
          },
          "constructor": {
            "additionalProperties": true,
            "type": "object",
            "title": "Constructor"
          }
        },
        "type": "object",
        "required": [
          "name",
          "code",
          "class_name"
        ],
        "title": "CustomComponentDraft"
      },
      "ForwardInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "title": "Name"
          },
          "binding": {
            "type": "string",
            "enum": [
              "positional",
              "keyword"
            ],
            "title": "Binding",
            "default": "positional"
          },
          "input": {
            "$ref": "#/components/schemas/InputSpec"
          }
        },
        "type": "object",
        "required": [
          "name",
          "input"
        ],
        "title": "ForwardInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InputFixture": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "input": {
            "$ref": "#/components/schemas/InputSpec"
          },
          "capture_mode": {
            "type": "string",
            "enum": [
              "values",
              "shapes"
            ],
            "title": "Capture Mode",
            "default": "values"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "name",
          "input",
          "id",
          "created_at"
        ],
        "title": "InputFixture"
      },
      "InputFixtureDraft": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "input": {
            "$ref": "#/components/schemas/InputSpec"
          },
          "capture_mode": {
            "type": "string",
            "enum": [
              "values",
              "shapes"
            ],
            "title": "Capture Mode",
            "default": "values"
          }
        },
        "type": "object",
        "required": [
          "name",
          "input"
        ],
        "title": "InputFixtureDraft"
      },
      "InputSpec": {
        "properties": {
          "shape": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 6,
            "minItems": 1,
            "title": "Shape"
          },
          "generator": {
            "type": "string",
            "enum": [
              "arange",
              "random",
              "ones",
              "zeros",
              "uploaded"
            ],
            "title": "Generator",
            "default": "arange"
          },
          "uploaded": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UploadedTensor"
              },
              {
                "type": "null"
              }
            ]
          },
          "dtype": {
            "type": "string",
            "enum": [
              "float32",
              "float64",
              "int64"
            ],
            "title": "Dtype",
            "default": "float32"
          },
          "seed": {
            "type": "integer",
